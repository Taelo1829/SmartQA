# ---------------------------------------------------------------------------
# SmartQA configuration
# Copy to .env and adjust. Everything below has a working local default;
# the production adapters are enabled by setting DATABASE_URL / REDIS_URL.
# ---------------------------------------------------------------------------

# "file" (default, zero-infrastructure, durable JSON store under .data/)
# or "postgres" (Prisma + PostgreSQL, required for multi-instance deployments).
STORAGE_DRIVER=file
DATABASE_URL=postgresql://smartqa:smartqa@localhost:5432/smartqa?schema=public

# "local" (default, DB-backed queue polled by the in-process worker)
# or "redis" (BullMQ; required for horizontally scaled workers).
QUEUE_DRIVER=local
REDIS_URL=redis://localhost:6379

# 32+ byte secret used for AES-256-GCM encryption of captured auth sessions.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_ENCRYPTION_KEY=dev-only-insecure-key-change-me-0123456789abcdef

# Public origin of this app (used for absolute links / PDF rendering)
APP_URL=http://127.0.0.1:4101

# Local auth bootstrap (seeded automatically on first login attempt)
BOOTSTRAP_EMAIL=qa@smartqa.local
BOOTSTRAP_PASSWORD=smartqa-demo-2026

# Browser
PLAYWRIGHT_CHANNEL=
PLAYWRIGHT_HEADLESS=true
MAX_CONCURRENT_BROWSERS=2
RUN_TIMEOUT_MS=600000

# Optional OpenAI-compatible LLM (planner/interpretation assist only).
# Without a key the platform runs fully deterministic heuristics.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Hard safety rails
ALLOW_PRIVATE_NETWORKS=false
ALLOW_DESTRUCTIVE_ACTIONS=false
