  "private": true,
  "scripts": {
    "dev": "next dev -p 4101",
    "prebuild": "node -e \"const fs = require('fs'); const path = require('path'); function walk(dir) { for (const f of fs.readdirSync(dir, { withFileTypes: true })) { const full = path.join(dir, f.name); if (f.isDirectory()) { const rel = path.relative('app', full); fs.mkdirSync(path.join('.next/server/app', rel), { recursive: true }); fs.mkdirSync(path.join('.next/types/app', rel), { recursive: true }); walk(full); } } } if (fs.existsSync('app')) walk('app');\"",
    "build": "next build",
    "start": "next start -p 4101"
  },
